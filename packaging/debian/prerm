#!/bin/sh
set -e
if [ "$1" = "remove" ] && command -v systemctl >/dev/null 2>&1; then
  systemctl stop sky-dashboard.service sky-paper.service sky-scan.timer sky-backup.timer sky-agent.service sky-agent.timer 2>/dev/null || true
  systemctl disable sky-dashboard.service sky-paper.service sky-scan.timer sky-backup.timer sky-agent.service sky-agent.timer 2>/dev/null || true
fi
exit 0
