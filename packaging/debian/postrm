#!/bin/sh
set -e
# The package-owned venv and Python caches are generated at configure/runtime,
# so dpkg does not know their files. Remove the application tree on uninstall;
# preserve operator data/config unless this is a purge.
case "$1" in
  remove|purge)
    rm -rf /opt/sky
    ;;
esac
case "$1" in
  purge)
    rm -rf /var/lib/sky /etc/sky
    if getent passwd sky >/dev/null; then
      deluser --system sky >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
