<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Cleartext is refused. Loopback HTTP is a debug-only exception. -->
    <base-config cleartextTrafficPermitted="false" />
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
