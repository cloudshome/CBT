# Required profile: live public data, paper-only progression.
# Installed as /etc/sky/sky.env (mode 0640, owner sky:sky).
DEMO_MODE=0
PROGRESSION=simulator
SYMBOL=BTCUSDT
SYMBOLS=BTCUSDT,ETHUSDT,XAUUSD
TIMEFRAME=15m
BARS=500

DESK_DEFAULT=true
PRIMARY_SETUP_FAMILY=sweep_trend_continuation
ENFORCE_RISK_LIMITS=true
TRADER_STATE_BLOCK=true
RISK_PCT=0.5
MAX_DAILY_LOSS_PCT=1.5
MAX_WEEKLY_LOSS_PCT=3.0
GOLD_SESSION_MODE=block
GOLD_NEWS_BLOCK=true

DB_PATH=/var/lib/sky/cryptobrain.db
SKY_STORE_ROOT=/var/lib/sky/store
PAPER_POLL_SECONDS=30
PAPER_MAX_CANDLES_PER_CHECK=1000

# Dashboard is write-capable. Gunicorn stays on loopback; TLS is Caddy/nginx.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
SKY_AUTH_MODE=auto
SKY_TRUSTED_PROXY_IPS=
SKY_ALLOW_REMOTE_NO_TLS=0
SKY_HUB_MODE=local

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_ANNOUNCE_WEBHOOK=
LLM_PROVIDER=off
