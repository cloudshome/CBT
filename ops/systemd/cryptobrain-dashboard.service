# Compatibility alias — prefer sky-dashboard.service (P19).
# Kept so existing hosts that enabled cryptobrain-* still have a unit file.
[Unit]
Description=CryptoBrain private dashboard (alias of sky-dashboard)
Documentation=file:/opt/sky/docs/PAPER_TRADING_OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sky
Group=sky
WorkingDirectory=/opt/sky
EnvironmentFile=-/etc/sky/sky.env
EnvironmentFile=-/etc/cryptobrain/cryptobrain.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sky/.venv/bin/gunicorn --workers 1 --threads 4 --timeout 120 --bind 127.0.0.1:8050 "web.app:make_app()"
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sky /var/lib/cryptobrain
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
