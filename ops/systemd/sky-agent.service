[Unit]
Description=SKY 24/7 Trading Intelligence & Research Agent
Documentation=https://github.com/Azimshawon/SKY
After=network-online.target
Wants=network-online.target
# Same FHS env as sky-dashboard.service. Dashboard / paper are separate units.

[Service]
Type=simple
User=sky
Group=sky
WorkingDirectory=/opt/sky
# Created by `python main.py hub setup`. Optional during first boot (- prefix).
EnvironmentFile=-/etc/sky/sky.env
Environment=PYTHONUNBUFFERED=1
# No trading credentials. Market data is public. DB_PATH comes from sky.env.
ExecStart=/opt/sky/.venv/bin/python -m sky_agent.daemon
Restart=always
RestartSec=5
WatchdogSec=60
# Hardening (least privilege)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sky /var/log/sky
# Structured logging — no secrets; use `journalctl -u sky-agent -f`
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sky-agent
# Graceful shutdown: SIGTERM drains one tick then exits
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
