[Unit]
Description=SKY 24/7 Trading Intelligence & Research Agent
Documentation=https://github.com/Azimshawon/SKY
After=network-online.target
Wants=network-online.target
# The dashboard and paper runner are separate units; the agent only needs network + disk.

[Service]
Type=simple
User=sky
Group=sky
WorkingDirectory=/opt/sky
# Environment file is created by `python main.py hub setup`; optional during first boot.
EnvironmentFile=-/etc/sky/sky.env
# No trading credentials are required for the research agent; market-data is public.
ExecStart=/opt/sky/.venv/bin/python -m sky_agent.daemon
Restart=always
RestartSec=5
WatchdogSec=60
# Hardening (least privilege)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sky /var/log/sky
# Structured logging — no secrets; use `journalctl -u sky-agent -f`
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sky-agent
# Graceful shutdown: SIGTERM drains one tick then exits
TimeoutStopSec=30
KillMode=mixed

[Install]
WantedBy=multi-user.target
