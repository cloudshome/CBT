# ==============================================================================
# AI QUANT SENTINEL / CRYPTO BRAIN TERMINAL (CBT) CONFIGURATION
# ==============================================================================

# System Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=cbt-super-secret-key-change-in-production-2026

# Public / Remote Access Gateway (Caddy HTTPS)
# Set to your domain (e.g. cbt.example.com) for auto Let's Encrypt TLS, or leave localhost / local IP
CBT_DOMAIN=localhost

# Data Storage
DATABASE_URL="file:./dev.db"
DATA_DIR=data
MARKET_DB_PATH=data/market_data.db
BRAIN_DB_PATH=data/brain_memory.db
TRADING_LOGS_DB_PATH=data/trading_logs.db
EXPERIMENT_DB_PATH=data/experiment_store.db

# Market Data Feeds
EXCHANGES=binance,bybit,coinbase,kraken,okx,hyperliquid
DEFAULT_SYMBOLS=BTC/USDT,ETH/USDT,XAU/USD
DEFAULT_TIMEFRAMES=1m,5m,15m,1h,4h,1d
DATA_STALENESS_THRESHOLD_MS=3000
CLOCK_DRIFT_THRESHOLD_MS=200

# Google Gemini Intelligence
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Telegram / WhatsApp Copilot Integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# Risk Management & Decision Engine
MAX_DAILY_DRAWDOWN_PCT=0.03
MAX_PORTFOLIO_HEAT_PCT=0.06
MAX_POSITION_RISK_CAP_PCT=0.015
MIN_NET_EV_HURDLE_R=0.25
EVENT_RISK_WINDOW_MINUTES=60
EVENT_RISK_EV_SURCHARGE_PCT=0.50

# Research & Governance
ENABLE_CAUSAL_FIREWALL=true
ENABLE_RESEARCH_FIREWALL=true
DEFLATED_SHARPE_MIN=1.5
HOLM_BONFERRONI_ALPHA=0.05
