[Unit]
Description=ORION / SKY Institutional Autonomous Trading & Risk Sentinel
After=network-online.target systemd-journald.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/CBT
ExecStart=/home/ubuntu/CBT/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000 --workers 2 --timeout-keep-alive 30
Restart=always
RestartSec=5s
KillMode=process
LimitNOFILE=65536

# Resource Hardening
MemoryHigh=3G
MemoryMax=3.5G
CPUQuota=200%

# Logging & Environment
StandardOutput=journal
StandardError=journal
EnvironmentFile=/home/ubuntu/CBT/.env

[Install]
WantedBy=multi-user.target
