[Unit]
Description=AI Quant Sentinel 24/7 Production Quantitative Engine
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/CBT
ExecStart=/root/CBT/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=10
StandardOutput=append:/var/log/ai_quant_sentinel.log
StandardError=append:/var/log/ai_quant_sentinel.error.log
EnvironmentFile=/root/CBT/.env

[Install]
WantedBy=multi-user.target
