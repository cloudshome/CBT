datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model CandlesCache {
  id        Int      @id @default(autoincrement())
  symbol    String
  timeframe String
  ts        BigInt
  o         Float
  h         Float
  l         Float
  c         Float
  v         Float
  createdAt DateTime @default(now())

  @@unique([symbol, timeframe, ts])
  @@index([symbol, timeframe, ts])
  @@map("candles_cache")
}
