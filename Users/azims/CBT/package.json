{
  "name": "ctb-terminal",
  "version": "3.0.0",
  "description": "Crypto Brain Terminal quantitative paper trading & desk platform",
  "main": "dist/electron/main.js",
  "author": "Crypto Brain Terminal Team",
  "scripts": {
    "build": "tsc && npm --prefix frontend run build",
    "build:backend": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "frontend:install": "npm --prefix frontend install",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "electron:build": "tsc -p electron/tsconfig.json",
    "electron:start": "electron dist/electron/main.js",
    "pack:windows": "python scripts/build_windows_app.py"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "electron": "^44.3.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
