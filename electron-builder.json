{
  "appId": "com.cbt.terminal",
  "productName": "Crypto Brain Terminal",
  "executableName": "ctb",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/electron/**/*",
    "frontend/dist/**/*",
    "frontend/public/**/*",
    "bin/**/*",
    "data/templates/**/*",
    "package.json",
    "cbt_backend.py",
    "app.py",
    "main.py",
    "core/**/*.py",
    "integrations/**/*.py",
    "requirements.txt",
    ".env.example"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "frontend/public/icon.png",
    "legalTrademarks": "Copyright (C) 2026 Crypto Brain Terminal / SKY Quantitative Systems"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Crypto Brain Terminal",
    "artifactName": "CTB_Setup_v${version}.${ext}",
    "uninstallDisplayName": "Crypto Brain Terminal Uninstall"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      }
    ],
    "category": "Finance",
    "executableName": "ctb",
    "maintainer": "Crypto Brain Terminal Team <info@cbt-sky.org>",
    "synopsis": "Crypto Brain Terminal quantitative paper trading & desk platform",
    "description": "Autonomous institutional quantitative crypto research, execution simulation, and cluster collective intelligence terminal.",
    "icon": "frontend/public/icon.png",
    "artifactName": "Crypto_Brain_Terminal_v${version}.${ext}"
  },
  "deb": {
    "priority": "optional",
    "packageCategory": "finance",
    "depends": [
      "gconf2",
      "gconf-service",
      "libnotify4",
      "libappindicator1",
      "libxtst6",
      "libnss3",
      "libasound2"
    ],
    "artifactName": "ctb_${version}_amd64.${ext}"
  },
  "appImage": {
    "artifactName": "Crypto_Brain_Terminal_v${version}.${ext}"
  }
}
