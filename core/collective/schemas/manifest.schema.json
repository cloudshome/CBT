{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SDCCManifest",
  "type": "object",
  "required": [
    "manifest_version",
    "node_id",
    "created_at",
    "events",
    "content_sha256",
    "signature"
  ],
  "properties": {
    "manifest_version": { "type": "integer", "minimum": 1 },
    "protocol_version": { "type": "integer", "minimum": 1 },
    "schema_version": { "type": "integer", "minimum": 1 },
    "node_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "events": {
      "type": "object",
      "required": ["first_sequence", "last_sequence", "count"],
      "properties": {
        "first_sequence": { "type": "integer", "minimum": 0 },
        "last_sequence": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "vector_clock": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "content_sha256": { "type": "string" },
    "knowledge_head": { "type": ["string", "null"] },
    "artifact_count": { "type": "integer", "minimum": 0 },
    "signature": { "type": "string" }
  }
}
