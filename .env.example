# ==============================================================================
# AI QUANT SENTINEL / CRYPTO BRAIN TERMINAL (CBT) CONFIGURATION
# ==============================================================================

# System Environment
APP_ENV=development
HOST=0.0.0.0
PORT=8000
# DEV PLACEHOLDER ONLY — NOT A REAL SECRET.
# Generate a unique value for every deployment: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_DEV_PLACEHOLDER_NOT_FOR_PRODUCTION

# CORS: leave empty in dev (allows all). In production this MUST be an explicit
# comma-separated origin allowlist ("*" is rejected at startup).
# CORS_ORIGIN=https://cbt.example.com

# Public / Remote Access Gateway (Caddy HTTPS)
# Set to your domain (e.g. cbt.example.com) for auto Let's Encrypt TLS, or leave localhost / local IP
CBT_DOMAIN=localhost

# Data Storage
DATABASE_URL="file:./dev.db"
DATA_DIR=data
MARKET_DB_PATH=data/market_data.db
BRAIN_DB_PATH=data/brain_memory.db
TRADING_LOGS_DB_PATH=data/trading_logs.db
EXPERIMENT_DB_PATH=data/experiment_store.db

# Market Data Feeds
EXCHANGES=binance,bybit,coinbase,kraken,okx,hyperliquid
DEFAULT_SYMBOLS=BTC/USDT,ETH/USDT,XAU/USD
DEFAULT_TIMEFRAMES=1m,5m,15m,1h,4h,1d
DATA_STALENESS_THRESHOLD_MS=3000
CLOCK_DRIFT_THRESHOLD_MS=200

# Google Gemini Intelligence
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Telegram / WhatsApp Copilot Integrations
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret Telegram sends as X-Telegram-Bot-Api-Secret-Token on webhooks.
# REQUIRED in production; webhook rejects requests when set and not matching.
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# Auth & Proxy Trust
# API_KEY - when set, sensitive endpoints must present Authorization: Bearer <key>
#           or X-API-Key header. MUST be set in production (APP_ENV=production).
API_KEY=
# Set to true ONLY when the service is reachable exclusively behind a reverse
# proxy that overwrites X-Forwarded-For (Caddy/nginx). If unset, the rate
# limiter ignores X-Forwarded-For to prevent header spoofing.
TRUST_PROXY_XFF=false

# Paper-Trading Risk Gate (FastAPI side, mirrors Express riskGate)
MAX_PAPER_OPEN_POSITIONS=3
MAX_PAPER_ACCOUNT_BALANCE=100000
MAX_PAPER_RISK_PCT=0.02

# Risk Management & Decision Engine
MAX_DAILY_DRAWDOWN_PCT=0.03
MAX_PORTFOLIO_HEAT_PCT=0.06
MAX_POSITION_RISK_CAP_PCT=0.015
MIN_NET_EV_HURDLE_R=0.25
EVENT_RISK_WINDOW_MINUTES=60
EVENT_RISK_EV_SURCHARGE_PCT=0.50

# Research & Governance
ENABLE_CAUSAL_FIREWALL=true
ENABLE_RESEARCH_FIREWALL=true
DEFLATED_SHARPE_MIN=1.5
HOLM_BONFERRONI_ALPHA=0.05

# ==============================================================================
# SDCC — SKY DISTRIBUTED COLLECTIVE CORE (MULTI-PC CLUSTER)
# ==============================================================================
# Target Google Drive Account (5 TB Cloud Mesh)
GDRIVE_USER_EMAIL=your_cluster_account@gmail.com
# Path to OAuth client secret (downloaded from Google Cloud Console)
GDRIVE_CLIENT_SECRET_FILE=credentials/gdrive_client_secret.json
# Path where authenticated OAuth token is stored
GDRIVE_OAUTH_TOKEN_FILE=credentials/gdrive_token.json
# Service Account JSON (alternative for headless 24/7 servers)
# GDRIVE_SERVICE_ACCOUNT_FILE=credentials/gdrive_service_account.json
# Dedicated Google Drive folder ID for SKY/09_CLUSTER_MESH (optional)
# GDRIVE_ROOT_FOLDER_ID=

# Local Node Configuration (Default auto-generated if omitted)
# SDCC_NODE_ID=UBUNTU-01
# SDCC_NODE_ROLE=RESEARCH_WORKER  # PRIMARY_CONTROLLER, RESEARCH_WORKER, OBSERVER, PAPER_TRADER

