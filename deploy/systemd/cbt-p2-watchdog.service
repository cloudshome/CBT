[Unit]
Description=CBT 24/7 P2_RP Ops Watchdog & Automated Ledger Backup (Hourly Check)
Documentation=https://github.com/cloudshome/CBT
After=network.target

[Service]
Type=oneshot
User=cloudslover
Group=cloudslover
WorkingDirectory=/home/cloudslover/CBT
Environment="PYTHONPATH=/home/cloudslover/CBT"
Environment="PYTHONUNBUFFERED=1"
Environment="CBT_SHADOW_DB_PATH=/home/cloudslover/CBT/data/p2_shadow_ledger.db"
ExecStart=/home/cloudslover/CBT/.venv/bin/python /home/cloudslover/CBT/main.py watchdog --check
TimeoutStartSec=120
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cbt-p2-watchdog

# Security Hardening (TIER_0_PAPER Permanent Invariant)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/cloudslover/CBT/data
